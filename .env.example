# Copy to .env (never commit .env). Everything is optional; the defaults use SQLite in data/.
# Uncomment only if you run the source database in Docker (docker compose up):
# SOURCE_DB_URL=postgresql+psycopg2://pmo:pmo@localhost:5432/source
SIM_SEED=42

# --- Stage 5: status update extraction -------------------------------------------
# Which extractor the Dagster pipeline uses: rules (no API) or llm
EXTRACTOR=rules
# gemini | groq | mistral | deepseek | kimi | ollama
LLM_PROVIDER=gemini
# Fill in the key for the provider you use (free keys: aistudio.google.com, console.groq.com;
# paid, a few cents for the whole evaluation: platform.deepseek.com, platform.moonshot.ai)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# Kimi keys from the China platform (platform.moonshot.cn) need LLM_BASE_URL=https://api.moonshot.cn/v1
# Optional overrides: model name (they change over time), requests per minute, cap per pipeline run
# LLM_MODEL=gemini-3.8-flash
# LLM_RPM=10
LLM_MAX_PER_RUN=200
